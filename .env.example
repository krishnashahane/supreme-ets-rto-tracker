# --- Object storage (private bucket, S3-compatible: Backblaze B2 / R2 / S3) ---
# Backblaze B2 example — copy the S3 endpoint from the bucket page.
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005          # optional; auto-derived from a B2 endpoint
S3_ACCESS_KEY_ID=              # B2 keyID
S3_SECRET_ACCESS_KEY=          # B2 applicationKey
S3_BUCKET=sfm-docs

# Legacy Cloudflare R2 vars (still supported as a fallback if S3_* unset):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=sfm-docs

# --- Vercel Blob (ONLY for the old blob->r2 migration scripts; optional) ---
BLOB_READ_WRITE_TOKEN=

# --- Session signing (JWT). Generate: openssl rand -base64 48 ---
SESSION_SECRET=

# --- Admin store encryption (AES-256-GCM). Generate: openssl rand -hex 32 ---
ADMIN_STORE_KEY=

# --- Super admin (hidden from admins & users). Hash: npm run hash "password" ---
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD_HASH=

# --- Basic user (search + download only). Hash: npm run hash "password" ---
USER_USERNAME=
USER_PASSWORD_HASH=
